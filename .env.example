# Teachease – AI-Powered Professor Assistant Environment Variables

# Centralized Google Gemini API Key
# Get your Gemini API key from https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Supabase Configuration (Optional - TeachEase has dual local/Supabase storage engine)
# Set your Supabase project URL and anon public key from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
